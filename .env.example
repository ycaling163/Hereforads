NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# 只给服务端 webhook 用(bypass RLS),千万不要加 NEXT_PUBLIC_ 前缀,
# 不能出现在任何浏览器端代码里。在 Supabase 后台 Settings → API 里拿。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe(老的 ad_spaces 日历预订 destination charge + 新的 listings MVP v2
# Charges & Transfers,两条产品线共用同一个 Stripe 项目/webhook 端点)。
# secret key 在 Stripe 后台 Developers → API keys 拿;webhook secret 是给
# `stripe listen` 或后台 webhook 端点配的 signing secret,不是 API key。
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Connect 开户/回调链接、Checkout 的 success/cancel url 都要拼绝对
# URL,本地开发用 http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 保护 /api/cron/auto-confirm(MVP v2 的买家超时自动确认收货)—— 外部定时
# 触发器(Vercel Cron / Supabase pg_cron)调用时要带
# Authorization: Bearer $CRON_SECRET,随便生成一个随机字符串。
CRON_SECRET=
